# scripts/ec2/config.env — shared config for the SF400 single-node EC2 benchmark
# (Polars + DuckDB on one big memory-rich box). Source it before every script:
#     source scripts/ec2/config.env
#
# Why single-node: SF400 is ~130 GB of Parquet (lineitem alone ~100 GB Snappy).
# On a 96 GB laptop it OOMs / needs streaming. On a 256 GB box the working set
# fits, so we get a fair cold single-pass number for both engines against local
# NVMe. Step 1 (stage_data.sh) puts the parquet on the instance's local NVMe:
# either GENERATE it in place with tpchgen-cli (fast, no S3 egress -- the default)
# or COPY the shared trino/ parquet down from S3.
export AWS_REGION="us-east-1"

# 256 GB box with a big local NVMe instance-store (the "id" family ships NVMe).
# Do NOT swap for an EBS-only type -- we put ~130 GB of parquet on local disk.
export INSTANCE_TYPE="r6id.4xlarge"      # 16 vCPU / 128 GiB / 1x950 GB NVMe
                                         # (== one node of the SF400 Spark/Trino cluster)
export AMI_ID="ami-0a02a779008fa3b99"    # Ubuntu 24.04 amd64 (Canonical, 2026-06-26)
export SSH_USER="ubuntu"

export KEY_NAME="ec2"
export KEY_PATH="/c/ai/code/ec2.pem"     # present locally (gitignored, NEVER commit)
export SG_ID="sg-xxxxxxxx"      # launch-wizard-1: SSH(22) from your IP only
export SUBNET_ID="subnet-xxxx"       # default subnet, us-east-1a
export VPC_ID="vpc-xxxxxxxx"             # default VPC (reference / SG creation)
export NAME_TAG="sf400-duckdb-polars-128g"

# Instance profile that lets the box read the repo tarball / write timings to S3.
# EMR_EC2_DefaultRole is created by `aws emr create-default-roles` (already run for
# the Spark/Trino work) and has broad S3 access -- reuse it. Set to your own if you
# locked S3 down.
export IAM_INSTANCE_PROFILE="EMR_EC2_DefaultRole"

# Data + output locations.
export S3_BUCKET="your_s3_bucket"
export S3_PREFIX="s3://your_s3_bucket"
# Shared per-table SF400 parquet (one file per table under <table>/) -- only used
# by stage_data.sh in COPY mode.
export DATA_S3="s3://your_s3_bucket/scale-400.0/trino"
# Where launch.sh drops the repo tarball for the box to fetch (user-data).
export REPO_TGZ_S3="s3://your_s3_bucket/code/polars-bench-repo.tgz"
# Where run_bench.sh uploads timings + console log.
export TIMINGS_S3="s3://your_s3_bucket/output/ec2_single_node"

# On-instance paths / benchmark knobs.
export SCALE_FACTOR="400.0"              # dir label scale-400.0 (harness convention)
export TABLES_DIR="/mnt/nvme/tables"     # PATH_TABLES on the box (NVMe mount)
export STAGE_MODE="generate"             # generate (tpchgen-cli, default) | copy (from S3)
export QUERY_TIMEOUT="1800"              # per-query hard cap (s); kills a hung/OOM query
export POLARS_STREAMING="true"           # true = streaming engine (safe at SF400);
                                         # set false to test the pure in-memory path
                                         # that a 256 GB box makes possible.
export ENGINES="duckdb polars"           # which engines run_bench.sh runs

# NOTE: SG only allows SSH from a fixed IP. Before launch, verify this box's public
# IP still matches, else add it:
#   MYIP=$(curl -s https://checkip.amazonaws.com)
#   aws ec2 authorize-security-group-ingress --region "$AWS_REGION" \
#     --group-id "$SG_ID" --protocol tcp --port 22 --cidr "$MYIP/32"
